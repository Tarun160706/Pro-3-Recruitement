# TalentIQ Environment Variables Example
# Copy this file to .env or configure your system environment variables.

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/talentiq_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Secret (Generate a secure 256-bit hex/base64 key for production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend URL for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
